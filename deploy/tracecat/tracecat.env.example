# DECA SOAR - Tracecat 1.5.2 OSS production env (design 11, 12.2 stage 1).
# TEMPLATE ONLY. Copy to /etc/deca-soar/tracecat.env (0600, root-owned, outside the repo),
# then fill from scripts/gen_secrets.py output and the Alibaba console. Never commit the filled file.
# Check before every deploy:  python scripts/preflight.py --env /etc/deca-soar/tracecat.env

# --- Edition: OSS only. Never change these two. ---
ENTERPRISE_EDITION=false
TRACECAT__FEATURE_FLAGS=

# --- Platform secrets (4): from gen_secrets.py, unique per environment ---
TRACECAT__DB_ENCRYPTION_KEY=
TRACECAT__SERVICE_KEY=
TRACECAT__SIGNING_SECRET=
USER_AUTH_SECRET=
TEMPORAL__PAYLOAD_ENCRYPTION_KEYRING=

# --- RDS PostgreSQL (Jakarta, same VPC; TLS on) ---
# Dedicated DB + user for Tracecat; the password lives only here.
TRACECAT__DB_URI=postgresql+psycopg://tracecat_app:<from-vault>@<rds-internal-host>:5432/tracecat
TRACECAT__DB_SSLMODE=require
# Optional least-privilege split (tracecat.db.roles): migrator/admin used only by the migrations job.
TRACECAT__DB_ROLE_LOGIN=
TRACECAT__DB_MIGRATOR_URI=
TRACECAT__DB_ADMIN_URI=
TRACECAT__DB_MIGRATOR_PASSWORD=
TRACECAT__DB_APP_PASSWORD=

# --- Temporal persistence on the same RDS instance, separate DBs/user ---
TEMPORAL__CLUSTER_URL=temporal:7233
TEMPORAL__CLUSTER_NAMESPACE=default
TEMPORAL__POSTGRES_SEEDS=<rds-internal-host>
TEMPORAL__POSTGRES_PORT=5432
TEMPORAL__POSTGRES_USER=temporal_app
TEMPORAL__POSTGRES_PASSWORD=
TEMPORAL__POSTGRES_DB=temporal
TEMPORAL__POSTGRES_VISIBILITY_DB=temporal_visibility
TEMPORAL__POSTGRES_TLS=true

# --- Tair (Redis-compatible), password + TLS ---
REDIS_URL=rediss://default:<from-vault>@<tair-internal-host>:6380/0

# --- OSS (S3-compatible, internal endpoint; bucket-scoped RAM user, NOT a write-capable SOAR key) ---
TRACECAT__BLOB_STORAGE_ENDPOINT=https://oss-ap-southeast-5-internal.aliyuncs.com
TRACECAT__BLOB_STORAGE_PRESIGNED_URL_ENDPOINT=https://oss-ap-southeast-5.aliyuncs.com
TRACECAT__BLOB_STORAGE_BUCKET_ATTACHMENTS=deca-soar-attachments
TRACECAT__BLOB_STORAGE_BUCKET_REGISTRY=deca-soar-registry
TRACECAT__BLOB_STORAGE_BUCKET_WORKFLOW=deca-soar-workflow
TRACECAT__BLOB_STORAGE_BUCKET_SKILLS=deca-soar-skills
TRACECAT__BLOB_STORAGE_BUCKET_AGENT=deca-soar-agent
DECA_OSS_REGION=ap-southeast-5
DECA_OSS_ACCESS_KEY_ID=
DECA_OSS_ACCESS_KEY_SECRET=

# --- Network: listen only on the ECS private IP, behind the DECA proxy ---
DECA_BIND_IP=10.x.x.x
PUBLIC_APP_PORT=8080
BASE_DOMAIN=:8080
TRACECAT__PUBLIC_APP_URL=https://soar.<internal-domain>
TRACECAT__PUBLIC_API_URL=https://soar.<internal-domain>/api
TRACECAT__TRUSTED_PROXY_CIDRS=10.x.x.x/32
TRACECAT__ALLOW_ORIGINS=https://soar.<internal-domain>

# --- Auth: SSO via OIDC (preferred) - basic only for first bootstrap, then removed ---
TRACECAT__AUTH_TYPES=oidc
TRACECAT__AUTH_ALLOWED_DOMAINS=<company-domain>
TRACECAT__AUTH_MIN_PASSWORD_LENGTH=16
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Sandbox: nsjail executor (needs docker-compose.sandbox.yml overlay) ---
TRACECAT__EXECUTOR_BACKEND=nsjail

# --- LLM: none in phase 0 (mocked in tests). Phase 1 per-domain egress via proxy. ---
