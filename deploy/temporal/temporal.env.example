# /etc/deca-soar/temporal/temporal.env (0640 root:temporal). No secrets here: the RDS password is
# /etc/deca-soar/secrets/temporal_db_password (0600 root), handed over with systemd LoadCredential=.
TEMPORAL_BIN_DIR=/opt/temporal/1.32.2
TEMPORAL_CONFIG_DIR=/etc/deca-soar/temporal/config
DYNAMIC_CONFIG_FILE_PATH=/etc/deca-soar/temporal/dynamicconfig/production.yaml
NUM_HISTORY_SHARDS=64

# RDS PostgreSQL (dedicated databases temporal + temporal_visibility, owner POSTGRES_USER)
POSTGRES_SEEDS=REPLACE_rds_private_endpoint
DB_PORT=5432
POSTGRES_USER=temporal
DBNAME=temporal
VISIBILITY_DBNAME=temporal_visibility
SQL_TLS_ENABLED=true
SQL_HOST_VERIFICATION=true
SQL_CA=/etc/deca-soar/temporal/tls/rds-ca.pem
SQL_HOST_NAME=REPLACE_rds_private_endpoint

# Private VPC IP of this ECS. Never 0.0.0.0, never a public IP.
BIND_ON_IP=REPLACE_private_ip

# mTLS: server cert for frontend + internode, CA that signed it, the CA for DECA client certs, and the
# system worker's client cert (signed by that client CA).
TEMPORAL_TLS_SERVER_CERT=/etc/deca-soar/temporal/tls/server.pem
TEMPORAL_TLS_SERVER_KEY=/etc/deca-soar/temporal/tls/server.key
TEMPORAL_TLS_CA_CERT=/etc/deca-soar/temporal/tls/server-ca.pem
TEMPORAL_TLS_SERVER_NAME=temporal.deca.internal
TEMPORAL_TLS_CLIENT_CA_CERT=/etc/deca-soar/temporal/tls/client-ca.pem
TEMPORAL_TLS_SYSTEM_WORKER_CERT=/etc/deca-soar/temporal/tls/system-worker.pem
TEMPORAL_TLS_SYSTEM_WORKER_KEY=/etc/deca-soar/temporal/tls/system-worker.key

# Metrics only on loopback, if at all.
# PROMETHEUS_ENDPOINT=127.0.0.1:9090
