[Unit]
Description=DECA SOAR: Temporal server 1.32.2 (self-hosted, MIT)
After=network-online.target temporal-schema.service
Requires=temporal-schema.service
Wants=network-online.target

[Service]
Type=simple
User=temporal
Group=temporal
EnvironmentFile=/etc/deca-soar/temporal/temporal.env
LoadCredential=temporal_db_password:/etc/deca-soar/secrets/temporal_db_password
ExecStart=/opt/deca-soar/deploy/temporal/bin/temporal-start.sh
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/etc/deca-soar/temporal /opt/temporal

[Install]
WantedBy=multi-user.target
